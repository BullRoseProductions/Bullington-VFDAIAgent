 "gate_fns": {
  "is_leader": {
   "def": "CREATE OR REPLACE FUNCTION public.is_leader()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select exists (\n    select 1 from members\n    where lower(members.email) = lower(auth.email())\n      and members.status in ('Active','Probationary')\n      and members.department_id = public.my_department_id()\n      and members.access && array['Project Admin','Department Admin','Board Member','Officer']::text[]\n  );\n$function$\n",
   "md5": "3f462af26a46909309f856f769226baa"
  },
  "my_member_id": {
   "def": "CREATE OR REPLACE FUNCTION public.my_member_id()\n RETURNS uuid\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select id\n  from public.members\n  where lower(email) = lower(auth.email())\n    and status in ('Active','Probationary')\n    and department_id = public.my_department_id()\n  limit 1;\n$function$\n",
   "md5": "3f66369c8af7bc07ec59831af6536fee"
  },
  "is_dept_admin": {
   "def": "CREATE OR REPLACE FUNCTION public.is_dept_admin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select exists (\n    select 1 from public.members\n    where lower(members.email) = lower(auth.email())\n      and members.status in ('Active','Probationary')\n      and members.department_id = public.my_department_id()\n      and members.access && array['Project Admin','Department Admin']::text[]\n  );\n$function$\n",
   "md5": "c692e44f62923d2bf4c1a39a21a87bf7"
  },
  "my_department_id": {
   "def": "CREATE OR REPLACE FUNCTION public.my_department_id()\n RETURNS uuid\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select coalesce(\n    -- 1) the saved active station, ONLY if it's still one of the caller's departments\n    ( select mad.department_id\n        from public.member_active_department mad\n       where mad.email = lower(auth.email())\n         and exists ( select 1 from public.members m\n                       where lower(m.email) = lower(auth.email())\n                         and m.status in ('Active','Probationary')\n                         and m.department_id = mad.department_id ) ),\n    -- 2) else their department, deterministically. Single-dept = byte-identical to the old body.\n    ( select m.department_id\n        from public.members m\n       where lower(m.email) = lower(auth.email())\n         and m.status in ('Active','Probationary')\n       order by m.department_id\n       limit 1 )\n  );\n$function$\n",
   "md5": "87f546659c3804a943b48e419e017f18"
  },
  "is_equipment_manager": {
   "def": "CREATE OR REPLACE FUNCTION public.is_equipment_manager()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  -- B4C:equipment managers — an ACTIVE registry row for the caller's member row IN the caller's department. Department-scoped\n  -- 2026-10-24 (the is_training_officer() shape): it used to match the caller's email in ANY department, so a manager in one\n  -- department was a manager in every department they belonged to.\n    select exists (\n      select 1 from public.equipment_manager em\n       where em.member_id = public.my_member_id()\n         and em.department_id = public.my_department_id()\n         and em.removed_at is null\n    );\n  $function$\n",
   "md5": "a979933dac145e88d58331a04d6c918a"
  }
 },
