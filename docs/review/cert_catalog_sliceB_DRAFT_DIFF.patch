+      IF v_ok THEN v_pass := v_pass + 1; rpt := rpt || format('   PASS  R4 expiring type: missing → expired (unsatisfied) → expiring (satisfied, in renewals_due) → current → no_date (unsatisfied)%s', chr(10));
