+  { kind: "final", label: "Final review → vote", node: "6mo" },
+];
+const PROB_MS_STATUS = { pending: "Pending", on_track: "On track", needs_work: "Needs work", done: "Done" };
+const PROB_SESSION_KIND = { ride_along: "Ride-along", drive: "Drive", shift: "Shift", other: "Other" };
+const PROB_HOURS_SOURCE = { supervised: "All supervised time", ride_along: "Ride-alongs", drive: "Drives", shift: "Shifts", training_nights: "Training nights attended" };
+const probDate = (ymd) => { if (!ymd) return ""; const d = new Date(`${String(ymd).slice(0, 10)}T12:00:00`); return isNaN(d) ? "" : d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }); };
