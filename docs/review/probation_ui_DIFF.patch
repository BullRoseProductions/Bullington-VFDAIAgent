+function probItemView(it, cfg, self) {
+  const unit = cfg?.hours_source === "training_nights" ? "nights" : "hr";
+  const signedOn = it.signed_at ? probDate(String(it.signed_at).slice(0, 10)) : "";
+  switch (it.state) {
+    case "signed": return { who: "officer", tone: "done", text: `Signed by ${it.signed_by_name || "an officer"}${signedOn ? ` · ${signedOn}` : ""}` };
+    case "done_unrecorded": return { who: "officer", tone: "done", text: "Done — sign-off not recorded" };
+    case "mentor_assigned": return { who: "officer", tone: "done", text: "Mentor assigned" };
+    case "open": return { who: "officer", tone: "todo", text: cfg?.is_mentor ? "No mentor assigned yet" : "Open — an officer signs this off" };
+    case "signed_current": return { who: "you", tone: "done", text: "Signed — current version" };
+    case "needs_signature": return { who: "you", tone: "warn", text: self ? "Needs your signature" : "Needs their signature", link: true };
+    case "not_required": return { who: "you", tone: "muted", text: "Not required for this role" };
+    case "met": return { who: "auto", tone: "done", text: `${probNum(it.have)} of ${probNum(it.target)} ${unit} · auto-tracked` };
+    case "in_progress": return { who: "auto", tone: "todo", text: `${probNum(it.have)} of ${probNum(it.target)} ${unit} so far` };
+    case "current": return { who: "auto", tone: "done", text: "Current cert on file" };
+    case "missing": return { who: "auto", tone: "warn", text: "No current cert on file" };
+    case "not_configured": return { who: it.kind === "ack" ? "you" : "auto", tone: "muted", text: "Not set up yet — the Department Admin finishes this item" };
+    default: return { who: "officer", tone: "todo", text: "Open" };
+  }
+}
