+const probNum = (n) => { const x = Number(n); return Number.isFinite(x) ? (Math.round(x * 10) / 10).toString() : "0"; };
+// One member's computed path (the caller's own when memberId is null). A failed read keeps the last status.
+function useProbationStatus(memberId, enabled = true) {
+  const [st, setSt] = useState(null);
+  const [err, setErr] = useState(false);
+  const load = React.useCallback(() => {
+    if (!enabled) return Promise.resolve();
+    const q = memberId ? supabase.rpc("member_probation_status", { p_member_id: memberId }) : supabase.rpc("my_probation_status");
+    return q.then(({ data, error }) => {
+      if (error || !data || typeof data !== "object") { setErr(true); return; }
+      setErr(false); setSt(data);
+    });
+  }, [memberId, enabled]);
+  useEffect(() => { setSt(null); load(); }, [load]);
+  useEffect(() => { window.addEventListener(RS_CHANGED, load); return () => window.removeEventListener(RS_CHANGED, load); }, [load]);   // an ack item can satisfy on a signature
+  useReconnect(() => { if (err) load(); });
+  return { st, err, reload: load };
+}
+// The item config the status JSON doesn't carry (the hours unit, the linked document) — dept-readable onboarding_items.
