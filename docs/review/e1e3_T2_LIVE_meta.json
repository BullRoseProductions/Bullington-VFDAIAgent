  "triggers": {
    "training_sessions.training_session_lock_guard": "CREATE TRIGGER training_session_lock_guard BEFORE INSERT OR UPDATE ON public.training_sessions FOR EACH ROW EXECUTE FUNCTION tg_training_session_lock_guard()",
    "training_sessions.trg_close_training_presence_on_done": "CREATE TRIGGER trg_close_training_presence_on_done AFTER UPDATE ON public.training_sessions FOR EACH ROW WHEN (((old.done IS DISTINCT FROM new.done) AND (new.done = true))) EXECUTE FUNCTION close_training_presence_on_done()",
    "session_attendance.session_attendance_membership_window": "CREATE TRIGGER session_attendance_membership_window BEFORE INSERT OR UPDATE OF session_id, member_id ON public.session_attendance FOR EACH ROW EXECUTE FUNCTION tg_session_attendance_membership_window()",
    "training_sessions.trg_close_training_presence_on_delete": "CREATE TRIGGER trg_close_training_presence_on_delete BEFORE DELETE ON public.training_sessions FOR EACH ROW EXECUTE FUNCTION close_training_presence_on_session_delete()",
    "training_sessions.training_session_date_membership_window": "CREATE TRIGGER training_session_date_membership_window BEFORE UPDATE OF date ON public.training_sessions FOR EACH ROW EXECUTE FUNCTION tg_training_session_date_membership_window()"
  },
  "constraints": {
    "training_sessions.training_sessions_pkey": "PRIMARY KEY (id)",
    "session_attendance.session_attendance_pkey": "PRIMARY KEY (id)",
    "training_sessions.training_sessions_actual_pair": "CHECK (((actual_start IS NULL) = (actual_end IS NULL)))",
    "training_sessions.training_sessions_setup_range": "CHECK (((setup_min IS NULL) OR ((setup_min >= 0) AND (setup_min <= 600))))",
    "training_sessions.training_sessions_plan_id_fkey": "FOREIGN KEY (plan_id) REFERENCES training_plans(id) ON DELETE SET NULL",
    "training_sessions.training_sessions_status_check": "CHECK ((status = ANY (ARRAY['scheduled'::text, 'cancelled'::text])))",
    "training_sessions.training_sessions_actual_length": "CHECK (((actual_start IS NULL) OR (NOT (duration_min IS DISTINCT FROM (((EXTRACT(epoch FROM (actual_end - actual_start)) / (60)::numeric))::integer +\nCASE\n    WHEN (actual_end <= actual_start) THEN 1440\n    ELSE 0\nEND)))))",
    "training_sessions.training_sessions_location_pair": "CHECK (((location_lat IS NULL) = (location_lng IS NULL)))",
    "training_sessions.training_sessions_audience_check": "CHECK ((audience = ANY (ARRAY['everyone'::text, 'leadership'::text, 'board'::text])))",
    "training_sessions.training_sessions_duration_range": "CHECK (((duration_min IS NULL) OR ((duration_min >= 1) AND (duration_min <= 1440))))",
    "session_attendance.session_attendance_member_id_fkey": "FOREIGN KEY (member_id) REFERENCES members(id) ON DELETE CASCADE",
    "session_attendance.session_attendance_session_id_fkey": "FOREIGN KEY (session_id) REFERENCES training_sessions(id) ON DELETE CASCADE",
    "training_sessions.training_sessions_department_id_fkey": "FOREIGN KEY (department_id) REFERENCES departments(id) ON DELETE CASCADE",
    "session_attendance.session_attendance_department_id_fkey": "FOREIGN KEY (department_id) REFERENCES departments(id) ON DELETE CASCADE",
    "training_sessions.training_sessions_actual_whole_minutes": "CHECK (((actual_start IS NULL) OR ((EXTRACT(second FROM actual_start) = (0)::numeric) AND (EXTRACT(second FROM actual_end) = (0)::numeric) AND (actual_end <> actual_start))))",
    "training_sessions.training_sessions_coords_require_offsite": "CHECK ((is_offsite OR ((location_lat IS NULL) AND (location_lng IS NULL))))",
    "session_attendance.session_attendance_session_id_member_id_key": "UNIQUE (session_id, member_id)"
  },
