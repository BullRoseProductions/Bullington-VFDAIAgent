+  END LOOP;
+  FOREACH v_err IN ARRAY array['public.onboarding_ping(uuid,uuid,text,text,text,text)', 'public.onboarding_caller_can_sign(uuid)', 'public.probation_item_states(uuid,uuid)'] LOOP
