+      body: `Each gets a reminder about their own expired or expiring-soon certs, credentials and gear — once per item per day. Push reaches members on app 2.2+ who turned notifications on; everyone else sees it in their B4C notifications.`,
+      confirmLabel: "Send reminders" }))) return;
+    setSending(true);
