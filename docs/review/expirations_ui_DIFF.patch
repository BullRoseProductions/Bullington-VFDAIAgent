+}
+function Expirations({ S, role, members, meId, notify }) {
+  const leader = hasAny(role, CANMANAGE_ROLES);          // dept_expirations()'s is_canmanage() gate
+  const ops = hasAny(role, CANMANAGE_OPS_ROLES);         // the seven writes: is_canmanage_ops()
+  const [rows, setRows] = useState(null);
+  const [err, setErr] = useState(false);
+  const [tick, setTick] = useState(0);
+  const [sending, setSending] = useState(false);
+  const reload = () => setTick((t) => t + 1);
+  useEffect(() => {
+    if (!leader) return;
+    let alive = true;
+    supabase.rpc("dept_expirations").then(({ data, error }) => { if (!alive) return; if (error || !Array.isArray(data)) { setErr(true); return; } setErr(false); setRows(data); });
+    return () => { alive = false; };
+  }, [tick, leader]);
+  useReconnect(() => { if (err) reload(); });
+  if (!leader) return <MyExpirationsPage />;
+  const ranked = expRank(rows);
