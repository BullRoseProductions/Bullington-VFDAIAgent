+// The member's own (my_expirations): their certs, credentials and assigned gear. Read-only. Hidden when they have none.
+function useMyExpirations(enabled = true) {
+  const [rows, setRows] = useState(null);
+  const [err, setErr] = useState(false);
+  const load = React.useCallback(() => {
+    if (!enabled) return;
+    supabase.rpc("my_expirations").then(({ data, error }) => { if (error || !Array.isArray(data)) { setErr(true); return; } setErr(false); setRows(data); });
+  }, [enabled]);
+  useEffect(() => { load(); }, [load]);
+  useReconnect(() => { if (err) load(); });
+  return { rows, err, reload: load };
+}
+function MyExpirationsCard() {
+  const { rows } = useMyExpirations(true);
+  const ranked = expRank(rows);
+  if (!ranked.length) return null;
+  const attention = ranked.filter((r) => r.ui !== "current").length;
+  return (
+    <Card padding="14px 16px" style={{ marginBottom: 14 }}>
+      <CardHead icon={Clock} title="Your upcoming expirations" right={attention ? <span style={{ color: FIRE.amberText, ...FS.num }}>{attention} need attention</span> : <span style={{ color: FIRE.greenText }}>All current</span>} />
+      <div style={{ margin: "0 -16px -14px" }}>{ranked.slice(0, 5).map((r, i) => <ExpRow key={`${r.source}-${r.item_id}`} r={r} last={i === Math.min(ranked.length, 5) - 1} />)}</div>
+    </Card>
+  );
+}
+function MyExpirationsPage() {
+  const { rows, err, reload } = useMyExpirations(true);
+  const ranked = expRank(rows);
+  return (
+    <PageShell band watermark="EXPIRY" kicker="COMPLIANCE" title="Your expirations" sub="Your certs, credentials and gear — what's current and what's coming up. Officers keep these records.">
+      <NoirSkin>
+      {err && !rows ? <Card padding={14} style={{ fontSize: 13, color: FIRE.amberText }}>Couldn't load your expirations. <button style={{ ...FS.btn, padding: "3px 9px", marginLeft: 6 }} onClick={reload}>Retry</button></Card>
+        : rows === null ? <Card padding={14} style={{ fontSize: 13, color: FIRE.textMuted }}>Loading…</Card>
+        : ranked.length === 0 ? <Card padding={14} style={{ fontSize: 13, color: FIRE.textMuted }}>Nothing on file for you yet.</Card>
+        : <ExpSections ranked={ranked} />}
