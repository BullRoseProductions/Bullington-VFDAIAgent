+const EXP_SECTION = {
+  expired: { label: "Expired · act now", color: FIRE.redText, rgb: "200,50,58", Icon: AlertTriangle },
+  no_date: { label: "No date · fix the record", color: FIRE.amberText, rgb: "204,158,82", Icon: AlertTriangle },
