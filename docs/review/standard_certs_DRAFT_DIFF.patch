# RLS on member_active_department). Nothing existing is edited — the migration only CREATEs (table, index, policy, seed, one RPC).
# DATA FLAG (for Tommy): 'Fire Inspector' and 'Incident Safety Officer' are in BOTH sffma and tcfp — a department can add only one of each
# (cert_types is unique per department by name), the second reads "That cert type is already in your catalog."

diff --git a/sql/standard_certs_DRAFT.sql b/sql/standard_certs_DRAFT.sql
