+ok("the document checkbox gates p_doc_checked = true", /disabled=\{!checked \|\| busy\} onClick=\{\(\) => go\(true\)\}/.test(seg));
+const code = seg.replace(/\/\*[\s\S]*?\*\//g, "").replace(/\/\/[^\n]*/g, "");   // the code + UI strings, comments removed
