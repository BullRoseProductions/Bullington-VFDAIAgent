# Capacitor / IDE local state (generated, machine-specific)
android/.idea/
ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Android signing material — NEVER commit. Losing the upload key means you can't ship updates;
# leaking it means someone else can sign as you.
*.jks
*.keystore
keystore.properties

# Local preview artefacts — generated samples for review, never part of the app.
# They were committed once by an over-broad `git add -A`; this stops it recurring.
_report_preview/
_digest_preview/

# Secrets. `.env` alone matched only that exact filename, leaving .env.local and
# .env.production — which is what `vercel env pull` writes — perfectly committable.
.env*
!.env.example

# Firebase service-account keys and APNs auth keys. Admin credentials that arrive
# as ordinary-looking files in ~/Downloads and are one `git add -A` from being public.
*firebase-adminsdk*.json
*.p8
CREDENTIALS.txt
