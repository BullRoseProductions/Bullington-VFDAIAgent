<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- RELEASE / App Store. The APNs environment must be `production` for any build signed with a
	     distribution profile — TestFlight and App Store included. App/App.entitlements keeps
	     `development` for Debug device builds, so both work without editing a shared file each time. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Universal links. Same value as App/App.entitlements on purpose: the domain does not vary
	     by build config, but each config reads only its own entitlements file, so the key must be
	     written in both or the archive ships without it. `applinks:` only — webcredentials is for
	     password AutoFill, which B4C does not use. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.b4thecall.com</string>
	</array>
</dict>
</plist>
